  "assumptions": [
    {
      "assumption_id": "A01",
      "text": "The main-view and reference-isometric body observations are grouped with the outer-body observation in Section A-A. The main-view section marker establishes correspondence, and Section A-A is canonical because it supplies the complete exterior dimensions and attached controls. The broad isometric description is not split into additional tooth, groove, or face observations."
    },
    {
      "assumption_id": "A02",
      "text": "The main-view internal teeth and Section A-A pitch-diameter observation are grouped using the A-A section correspondence. Section A-A is canonical because it carries datum A and the pitch-diameter callout; feature_type is deliberately taken from main_view:F2 because the front view explicitly identifies the toothed profile rather than a smooth bore."
    },
    {
      "assumption_id": "A03",
      "text": "The SEE DETAIL A marker identifies detail_a:F1 and section_aa:F6 as the same retaining groove. Detail A is canonical for the groove profile, while Section A-A contributes its axial location and the datum B shoulder definition."
    },
    {
      "assumption_id": "A04",
      "text": "detail_a:F5 is interpreted as the upper end face section_aa:F2 because Detail A enlarges the upper groove region and the surface-profile control matches that face rather than the lower face. Section A-A is canonical for end-face identity; the additional Detail A parallelism control is retained."
    },
    {
      "assumption_id": "A05",
      "text": "break_edge_detail:F3 remains a separately scoped active-flank subfeature rather than being merged into the entire tooth-profile feature. Its prohibition on edge breaking must remain distinguishable from the permitted crest and root edge breaks, which also remain separate features."
    },
    {
      "assumption_id": "A06",
      "text": "The differently dimensioned internal bore steps remain distinct despite sharing datum references. In particular, detail_a:F2 is not merged with the datum A pitch-cylinder observation merely because its bore diameter coincides with the gear pitch diameter derivable from the specification table."
    },
    {
      "assumption_id": "A07",
      "text": "The global machining axis follows the mutually consistent main-view and Detail A Z-axis conventions. Section A-A's Y-axis designation is treated as view-local axial notation, not as a different physical part axis. Original extracted feature geometry is not rewritten."
    },
    {
      "assumption_id": "A08",
      "text": "The groove diameter and datum B shoulder remain constituent surfaces of one merged groove feature. The resulting intra-feature datum-reference relationship records the diameter's reference to the distinct shoulder, not a self-reference of the same controlled surface."
    },
    {
      "assumption_id": "A09",
      "text": "detail_a:F4 remains a separate relief undercut. Its SHAPE NOT IMPORTANT note is respected; no exact undercut diameter or correspondence to another bore step is invented."
    },
    {
      "assumption_id": "A10",
      "text": "The upper and lower entry features remain distinct bore/lead-in transitions. An additional independent constant-diameter depth is not assumed solely from their unfilled depth fields; their existing diameters, lead-in angles, and adjacent axial landmarks are retained without inventing geometry."
    },
    {
      "assumption_id": "A11",
      "clarification_id": "C01",
      "text": "The axial length of the \u00d8185.5 \u00b1 0.25 intermediate internal bore step is 3.2 \u00b1 0.09 mm, measured between its defining shoulders as shown in Detail A."
    },
    {
      "assumption_id": "A12",
      "clarification_id": "C02",
      "text": "The axial length of the \u00d8185\u00b10.25 internal bore is 9.91 mm nominal, determined by subtracting the 3.2\u00b10.09 mm step depth from the 13.11\u00b10.1 mm overall feature dimension."
    },
    {
      "assumption_id": "A13",
      "clarification_id": "C03",
      "text": "The profile-deviation (F\u03b1) limit is assumed to be 0.4 mm relative to datum B as specified by the surface profile tolerance, applied across the active tooth flank between the maximum form diameter boundaries (points Q and M)."
    },
    {
      "assumption_id": "A14",
      "clarification_id": "C04",
      "text": "The helix-slope-deviation fH\u03b2 limit specified by the referenced gear chart is assumed to be \u00b10.015 mm across the 37.3 mm tooth face width."
    },
    {
      "assumption_id": "A15",
      "clarification_id": "C05",
      "text": "The maximum form diameter defining the M and Q boundaries corresponds directly to the specified form diameter value from the gear data table, designating the limit of the active involute profile where the 0\u20131 edge breaks terminate and blend into the tooth flank."
    }
  ]

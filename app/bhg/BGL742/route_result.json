  "clarifications": [
    {
      "clarification_id": "C01",
      "question": "No heat treatment specified, quoted soft; confirm whether HT is in your scope.",
      "why_it_matters": "The drawing and the extracted specifications state material 8620 and do not state a case depth, hardness, or carburise note. 8620 is often carburised, but nothing on this sheet puts heat treatment in scope, so the route and the price are soft and include no post-HT finishing. If heat treatment is yours to do, the route and the price both change.",
      "blocks": [],
      "suggested_default": null,
      "priority": "high"
    }
  ],
  "assumptions": [
    {
      "assumption_id": "A01",
      "text": "No heat treatment is specified on the drawing or in the extracted specifications. The ring is quoted soft. Incoming hardness is the supplied annealed or normalised condition, not a final specification."
    },
    {
      "assumption_id": "A02",
      "text": "The blank is a bought-in forged ring, Ø213 / Ø175 × 58 mm, gross 5.2723 kg. Finished height is 53.8 mm and net weight is 2.8103 kg. Material stays at ₹75/kg. There is no in-house saw, heat, forge, or trim."
    },
    {
      "assumption_id": "A03",
      "text": "The internal spur is shaped, rough then finish, because an internal gear cannot be hobbed. Internal shaving is not used: flank and root Ra are 3.2 and the stated ffα 0.02, ffβ 0.02 and fpt 0.023 are taken from the finish shaping pass. Shaving an internal gear would need a special machine the drawing does not call for."
    },
    {
      "assumption_id": "A04",
      "text": "No drilled-hole or slot pattern is in the extracted features, so there is no VMC operation. Tooth edge breaks go on a chamfer-deburr machine. Setups are amortised over 100 pieces and sit inside each operation cycle, as on the JAL routes."
    },
    {
      "assumption_id": "A05",
      "text": "Gear inspection is 100% over pins and a sampled gear-analyser check. Final CMM is sampled. Marking is included because the bottom face is noted as an optional marking location. No coating is specified, so rust-preventive oil is preservation only. The chamfer-deburr machine is costed at ₹350/hr, the gear-machine rate already used for shaping; the shop card has no separate chamfer rate."
    }
  ]
}

  "clarifications": [
    {
      "clarification_id": "C01",
      "question": "No heat treatment specified, quoted soft; confirm whether HT is in your scope.",
      "why_it_matters": "The drawing and the extracted specifications state material 8620 and do not state a case depth, hardness, or carburise note. 8620 is often carburised, but nothing on this sheet puts heat treatment in scope, so the route and the price are soft and include no post-HT finishing. If heat treatment is yours to do, the route and the price both change.",
      "blocks": [],
      "suggested_default": null,
      "priority": "high"
    }
  ],
  "assumptions": [
    {
      "assumption_id": "A01",
      "text": "No heat treatment is specified on the drawing or in the extracted specifications (part note: heat treatment none specified). The ring is quoted soft. 8620 in the bought-in blank is assumed annealed or normalised and machinable. Confirm whether heat treatment is in scope before release."
    },
    {
      "assumption_id": "A02",
      "text": "The blank is a bought-in forged/rolled ring from an outside forge shop, not round bar and not a forging made on the Bharat Gears floor. No saw, heat, forge, or trim operation is routed. The raw-material line is the purchase cost of that ring."
    },
    {
      "assumption_id": "A03",
      "text": "Finished overall height is 53.8 mm = 16.5 mm (top face to datum B) + 37.3 mm (datum B to the bottom face). The bought-in ring is Ø213 mm OD × Ø175 mm ID × 58 mm long: 2.5 mm radial allowance over the Ø208 nominal OD, about 3 mm radial allowance under the Ø181.026 tooth tip, and 2.1 mm on each face. Gross weight is 5.2723 kg at 7.85 g/cm³. Material is priced at ₹75/kg, the rate already used for this part."
    },
    {
      "assumption_id": "A04",
      "text": "Net weight is 2.8103 kg. That is a steel annulus Ø208 mm × effective ID Ø186.24 mm (mean of the Ø181.026 tooth tip and the Ø191.45 mean root) × 53.8 mm at 7.85 g/cm³, minus the Ø191 × 3.2 mm snap-ring groove. The bore is subtracted; the part is not costed as a solid disc. Scrap is 2.462 kg."
    },
    {
      "assumption_id": "A05",
      "text": "Internal shaving is not included. Flank and root finish are Ra 3.2 and no shaving stock is specified. The internal spur teeth are shaped only, across the 37.3 mm face, after the Ø181.026 minor is turned. The 37.3 mm figure is the toothed section from datum B to the bottom face, not the overall height."
    },
    {
      "assumption_id": "A06",
      "text": "Tooth edge breaking is limited to F05 and F06 (break edge 0–1 mm). The active flank F07 is not edge-broken. The general deburr note still applies."
    },
    {
      "assumption_id": "A07",
      "text": "Inspection time is an average per piece for a 100-piece lot: first-off CMM and a sampled gear-analyser check, plus a short 100% check of runout, tooth size, groove width, and the edge break. A full CMM and gear-analyser cycle is not charged on every piece. Setups are amortised over the 100 pieces and are inside the cycle time used for cost."
    }
  ]

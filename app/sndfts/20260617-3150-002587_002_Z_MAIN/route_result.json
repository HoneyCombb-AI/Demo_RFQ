  "assumptions": [
    {
      "assumption_id": "A01",
      "text": "The routing view does not state the material designation or blank type. A grey-iron casting is selected provisionally because it is an available stock form and is consistent with the stated 150\u2013190 HBW hardness range; confirm before quoting or production."
    },
    {
      "assumption_id": "A02",
      "text": "Stress relief is assumed for the casting before machining, following the casting route sequence. The specified 150\u2013190 HBW condition is not treated as a hardening requirement."
    },
    {
      "assumption_id": "A03",
      "text": "The datum layout and casting stock distribution are not fully described in the routing view. The route assumes F09 can be faced on the VTC, F10 can then be machined on the VMC, and sufficient stock exists on all machined features."
    },
    {
      "assumption_id": "A04",
      "text": "A separate semi-finish pass is included for the H7 bore F38. Other semi-finishing is not represented as a distinct pass because the controlled operation vocabulary has no general semi-finish turning operation; final cuts follow completion of all rough machining."
    },
    {
      "assumption_id": "A05",
      "text": "The H7 bore F38 is finish-bored on the VTC. Honing is omitted because the shop route specifies no hone and the shop has no honing machine."
    },
    {
      "assumption_id": "A06",
      "text": "No pressure-test requirement is stated, so the casting-route pressure test step is not included."
    },
    {
      "assumption_id": "A07",
      "text": "The six openings F23 are assumed to be milled slots, with the minimum-thickness web F44 left by that material removal. The complete slot depth and profile require confirmation."
    },
    {
      "assumption_id": "A08",
      "text": "F43 is assumed to be accessible in the axial-face drilling setup, and F29\u2013F31 are assumed to be turned-edge chamfers. Confirm feature orientations and edge locations against the drawing."
    }
  ]
}

  "assumptions": [
    {
      "assumption_id": "A01",
      "text": "section_aa:F3 (Central Cylinder Body) and isometric_view:F1 (Central cylinder) are the same physical feature; section_aa:F3 chosen canonical because it is fully dimensioned and defines datum C."
    },
    {
      "assumption_id": "A02",
      "text": "main_view:F2 and section_aa:F2 both describe the central flange; main_view:F2 selected canonical due to attached GD&T and datum-B definition. The 6.63 width in section_aa:F2 is treated as an inspection/reference value (B1) rather than the controlling axial length."
    },
    {
      "assumption_id": "A03",
      "text": "isometric_view:F5 (Top-left hole) refers to the left slotted hole seen in main_view:F3; grouped despite differing feature_type labels because the isometric is non-dimensional context only."
    },
    {
      "assumption_id": "A04",
      "text": "isometric_view:F3 (Bottom-right hole) refers to the right circular through hole in main_view:F5; grouped accordingly."
    },
    {
      "assumption_id": "A05",
      "text": "section_aa:F5 shows both end holes as an aggregate observation; it is linked as an aggregate_ref to the individual left slot and right circular hole groups, not as a standalone feature."
    },
    {
      "assumption_id": "A06",
      "text": "Primary machining axis is taken as the shaft axis (datum C, X-axis) despite the main view note calling Z the primary bore axis for the end holes."
    },
    {
      "assumption_id": "A07",
      "text": "right_view features (F1–F4) are treated as real features of this part but have no unambiguous counterparts in other sections; they remain singletons pending depth clarification."
    },
    {
      "assumption_id": "A08",
      "text": "The circular flat-face features on the lugs in main_view (F4, F6) are not grouped with section_aa:F1/F4 end flats because the section-cut callouts address different surfaces (top/bottom flats vs. circular machined patches)."
    },
        {
      "assumption_id": "A09",
      "text": "The outer diameter of the central flange is not explicitly dimensioned on the drawing and is defined directly by the 3D CAD master model as specified in the drawing notes."
    },
    {
      "assumption_id": "A10",
      "text": "The overall lug thickness along the Z-axis is assumed to be 38.25 / 37.75 mm, as indicated by the 2X 38.25 / 37.75 dimension callout."
    },
    {
      "assumption_id": "A11",
      "text": "The four peripheral notches have a specified root diameter of 70.00 mm TYP., which defines their depth relative to the outer diameter range of 79.8 mm to 80.2 mm."
    },
    {
      "assumption_id": "A12",
      "text": "The inner central slot passes completely through (THRU) the central bore feature, spanning across the inner diameter."
    },
    {
      "assumption_id": "A13",
      "text": "The depth of the two outer central cutouts is governed by the 2X 46.57 mm distance between the parallel flats relative to the nominal Ø80.0 mm outer diameter."
    }
  ]
}
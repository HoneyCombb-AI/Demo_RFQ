  "assumptions": [
    {
      "assumption_id": "A01",
      "text": "Round bar is used instead of a forged blank despite the 100000-piece quantity because the part is a simple short rotational ring and the estimated bar-stock removal is below the near-net forging threshold; all forging-template steps are therefore omitted."
    },
    {
      "assumption_id": "A02",
      "text": "A standard \u00d835 mm by 41 mm sawn blank provides the required 3\u20135 mm diameter allowance and 5\u201310 mm total length allowance."
    },
    {
      "assumption_id": "A03",
      "text": "Material is treated as medium machinability in the ferritic-pearlitic condition and hardened after carburizing and quenching; HRC values are left null because the drawing specifies Vickers hardness and a case/core gradient rather than one uniform HRC value."
    },
    {
      "assumption_id": "A04",
      "text": "All exposed surfaces are carburized without masking unless clarification C02 specifies selective protection."
    },
    {
      "assumption_id": "A05",
      "text": "The left face F06 is used as the axial process master pending clarification C03 because the datum scheme defines only the bore axis."
    },
    {
      "assumption_id": "A06",
      "text": "F04 is routed as one annular R0.8-profile face feature per side pending clarification C01."
    },
    {
      "assumption_id": "A07",
      "text": "Reaming and soft finish boring are omitted because the bore must be corrected after heat treatment by ID grinding and honing; honing is the final operation on the straight bore."
    },
    {
      "assumption_id": "A08",
      "text": "Threading, tapping, counterboring, part-off, and deep-hole peck drilling are omitted because no corresponding features exist and the blanks are individually sawed."
    },
    {
      "assumption_id": "A09",
      "text": "Gear teeth honing, bore lapping, and superfinishing are omitted because the specified DIN/ISO grade and Rz6 tooth finish are expected to be achieved by hard gear grinding and bore honing."
    },
    {
      "assumption_id": "A10",
      "text": "Straightening and additional stress relief are omitted because this is a short, rigid ring rather than a long shaft; distortion is checked after heat treatment and corrected by face, ID, and gear grinding."
    },
    {
      "assumption_id": "A11",
      "text": "The gear-template tooth-chamfer step is implemented as controlled deburring rather than a geometric chamfer because F11 specifies only a permitted edge-break or burr zone with a 0.4 mm maximum."
    },
    {
      "assumption_id": "A12",
      "text": "Bore-entry tapers, bore chamfers, and shallow face grooves are finished after face grinding so they are not erased or dimensionally shifted by post-heat-treatment stock removal."
    }
  ]

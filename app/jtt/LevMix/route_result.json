  "assumptions": [
    {
      "assumption_id": "A01",
      "text": "F05 and F13 are treated as two representations of one coaxial bore, while F07 and F12 are retained center-entry details used for supported turning."
    },
    {
      "assumption_id": "A02",
      "text": "The generic auxiliary-view features are treated as duplicate physical surfaces where their descriptions align: F14 with F06, F15 with F01, F18 with F09, F19 with F02, and F20 with F11; F16 remains a distinct left-side cylinder."
    },
    {
      "assumption_id": "A03",
      "text": "Round bar is selected instead of forging because the quantity is 100, the envelope is small and rotational, and standard bar creates no compelling near-net-shape benefit at this volume."
    },
    {
      "assumption_id": "A04",
      "text": "Soft turning leaves controlled finishing stock on the bore, end faces, datum journals, and runout-controlled diameters for the corrected post-heat-treatment CNC hard-turning operation."
    },
    {
      "assumption_id": "A05",
      "text": "The dedicated teeth-chamfering station is represented by machine_family gear_hobbing because the supplied inventory has no separate teeth-chamfer machine key; no hobbing of hardened teeth occurs in that operation."
    },
    {
      "assumption_id": "A06",
      "text": "Gear grinding, teeth honing, ID grinding, bore honing, face grinding, and OD grinding are deliberately removed under corrections GEAR-001 and GEAR-002 for DIN quality 8; CNC hard turning is the authoritative substitute."
    },
    {
      "assumption_id": "A07",
      "text": "Turning-template threading and part-off steps are omitted because no threads are defined and blanks are individually saw cut; unsupported hole-making steps such as reaming, tapping, counterboring, and deep-hole drilling are omitted because no corresponding features or requirements exist."
    },
    {
      "assumption_id": "A08",
      "text": "No carburizing mask or additional stress-relief cycle is routed because the drawing specifies general case hardening without selectively soft areas; pre-temper straightening is retained because the shaft has a slender rotational form."
    },
    {
      "assumption_id": "A09",
      "text": "The surface-treatment coating sequence is dropped because the drawing specifies no coating. Shot blasting is retained solely as post-heat-treatment descaling required by correction GEAR-003 and the heat-treatment sequence."
    },
    {
      "assumption_id": "A10",
      "text": "The standard gear-route final deburr is not repeated after hard turning because tooth burrs are removed before heat treatment, hardened tooth edges receive dedicated chamfering, and final turned edges are chamfered in the hard-turn operation before mandatory washing."
    }
  ]

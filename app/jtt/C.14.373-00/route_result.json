  "clarifications": [
    {
      "clarification_id": "C01",
      "question": "Which allowed machine-family key should represent the dedicated post-heat-treatment teeth-chamfering machine?",
      "blocks": [
        12
      ],
      "suggested_default": "Use gear_hobbing with a dedicated production teeth-chamfering cutter and fixture.",
      "priority": "medium"
    },
    {
      "clarification_id": "C02",
      "question": "Does the hardness callout 630+100 HV10 mean an acceptable range of 630\u2013730 HV10?",
      "blocks": [
        10,
        11,
        14
      ],
      "suggested_default": "Interpret the requirement as 630\u2013730 HV10 with effective case depth 0.3\u20130.5 mm.",
      "priority": "high"
    },
    {
      "clarification_id": "C03",
      "question": "What tooth-tip rounding is required for the gear-table parameter r_k marked with a question mark?",
      "blocks": [
        5,
        6,
        12
      ],
      "suggested_default": "Use the hob-generated tip condition and specified deburring without adding an intentional tooth-tip radius.",
      "priority": "high"
    }
  ],
  "assumptions": [
    {
      "assumption_id": "A01",
      "text": "Round bar is selected instead of a forging because the quantity is 100 pieces, the geometry is a small simple disc, and no metallurgical forging requirement is specified."
    },
    {
      "assumption_id": "A02",
      "text": "Stock diameter and cut length are deferred because no available bar size is stated; procurement should use the nearest standard bar providing 3\u20135 mm diametral and 5\u201310 mm axial machining allowance."
    },
    {
      "assumption_id": "A03",
      "text": "The blank OD is soft-finished before hobbing and heat treatment because GEAR-002 prohibits post-heat-treatment OD grinding; established heat-treatment distortion compensation is assumed necessary to retain the final OD and runout limits."
    },
    {
      "assumption_id": "A04",
      "text": "Turning-template grooving, threading, and part-off steps are omitted because no grooves or threads exist and individual blanks are prepared by sawing."
    },
    {
      "assumption_id": "A05",
      "text": "Peck drilling, tapping, counterboring, countersinking, and reaming are omitted because the only hole is a short through-bore that is bored and then hard-turned to final H7 size."
    },
    {
      "assumption_id": "A06",
      "text": "ID grinding, bore honing, face grinding, OD grinding, bore lapping, and post-lap verification are removed under GEAR-002 and replaced by the single correction-mandated CNC hard-turning operation."
    },
    {
      "assumption_id": "A07",
      "text": "Gear grinding and teeth honing are removed under GEAR-001 because the specified quality is DIN 8 and soft hobbing plus shaving is authoritative for this route."
    },
    {
      "assumption_id": "A08",
      "text": "Heat-treatment masking, straightening, and separate stress relief are omitted because selective hardening is not called out and the part is a short symmetric gear rather than a slender distortion-prone shaft."
    },
    {
      "assumption_id": "A09",
      "text": "The shot-blast operation serves as the heat-treatment descale step; plating, coating, coating masking, curing, and unmasking are omitted because no coating is specified."
    },
    {
      "assumption_id": "A10",
      "text": "The dedicated teeth-chamfering equipment has been provisionally mapped to the allowed gear_hobbing machine family because the shop profile has no explicit teeth-chamfering family key."
    }
  ]
}

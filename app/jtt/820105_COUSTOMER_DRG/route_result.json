  "clarifications": [
    {
      "clarification_id": "C01",
      "question": "Which drawing material option applies to this production order: 16MnCr5/ESP 65 or 42CrMo4?",
      "blocks": [
        10,
        11
      ],
      "suggested_default": "Use the primary 16MnCr5 option with case carburizing, quenching, and tempering.",
      "priority": "high"
    },
    {
      "clarification_id": "C02",
      "question": "What feature_id should represent the external helical tooth zone?",
      "blocks": [
        5,
        6,
        7,
        12,
        13,
        16
      ],
      "suggested_default": "Use F02 as the tooth-zone proxy because the teeth are generated from the modeled gear outer diameter.",
      "priority": "high"
    },
    {
      "clarification_id": "C03",
      "question": "What feature_ids should represent the two axial gear faces?",
      "blocks": [
        2,
        3,
        14
      ],
      "suggested_default": "Retain the required facing sub-operations with empty target_feature_ids until axial-face features are added to the graph.",
      "priority": "medium"
    },
    {
      "clarification_id": "C04",
      "question": "Is a dedicated hardened-gear teeth-chamfering machine available in-house?",
      "blocks": [
        12
      ],
      "suggested_default": "Subcontract dedicated post-heat-treatment teeth chamfering.",
      "priority": "high"
    },
    {
      "clarification_id": "C05",
      "question": "What round-bar diameter is to be used for the 100-piece lot?",
      "blocks": [
        1,
        2
      ],
      "suggested_default": "Use the nearest available standard round bar providing at least 2\u20133 mm diametral machining allowance over F02.",
      "priority": "high"
    },
    {
      "clarification_id": "C06",
      "question": "What saw-cut blank length per part is to be used?",
      "blocks": [
        1,
        2
      ],
      "suggested_default": "Use the finished axial width plus sufficient allowance for two faced ends and parting loss.",
      "priority": "high"
    }
  ],
  "assumptions": [
    {
      "assumption_id": "A01",
      "text": "Round bar is selected instead of a forging because the part is a simple small rotational gear and the quantity of 100 is below the stated forging-volume threshold."
    },
    {
      "assumption_id": "A02",
      "text": "The route uses the primary 16MnCr5 material option pending customer confirmation; selecting 42CrMo4 would replace furnace carburizing and tempering with selective induction hardening of the gearing."
    },
    {
      "assumption_id": "A03",
      "text": "F02 is used as the proxy target for hobbing, shaving, tooth chamfering, blasting, and gear inspection because the extracted feature graph lacks a dedicated gear-tooth feature."
    },
    {
      "assumption_id": "A04",
      "text": "ID grinding, bore honing, face grinding, and OD grinding are removed and replaced by one post-heat-treatment CNC hard-turning operation in accordance with correction GEAR-002."
    },
    {
      "assumption_id": "A05",
      "text": "Gear grinding and teeth honing are omitted because the specified DIN quality is 8d and correction GEAR-001 requires hob-and-shave processing at this quality."
    },
    {
      "assumption_id": "A06",
      "text": "The pre-heat-treatment bore is semi-finished rather than finish-bored or reamed so that heat-treatment distortion and the final H7 size can be corrected by CNC hard turning."
    },
    {

  "assumptions": [
    {
      "assumption_id": "A01",
      "text": "The route defaults to the primary 16MnCr5 / ESP 65 material option and its specified case-hardening and tempering cycle; selecting 42CrMoPb4 requires substitution with selective induction hardening."
    },
    {
      "assumption_id": "A02",
      "text": "At 100 pieces, round bar is preferred over forging because volume is below the stated forging threshold and the maximum blank diameter is close to available bar size."
    },
    {
      "assumption_id": "A03",
      "text": "F01 is interpreted as a through double-flat internal form and is broached after preparation of its round pilot bore."
    },
    {
      "assumption_id": "A04",
      "text": "Soft turning leaves controlled post-HT stock on the bore, specified faces, and \u00d824 u6 hub; the gear tip blank is completed before hobbing."
    },
    {
      "assumption_id": "A05",
      "text": "DIN 58405 quality 9d is treated as DIN quality 8 or coarser, so soft hobbing plus shaving is used and tooth grinding and tooth honing are removed."
    },
    {
      "assumption_id": "A06",
      "text": "ID grinding, bore honing, face grinding, and OD grinding from the standard gear and grinding routes are removed under correction GEAR-002 and replaced by one CNC hard-turning operation."
    },
    {
      "assumption_id": "A07",
      "text": "Lapping, superfinishing, profile grinding, and surface grinding are omitted because no corresponding tolerance or finish requirement remains after application of the hard-turning correction."
    },
    {
      "assumption_id": "A08",
      "text": "Center drilling is omitted because the blank has a low length-to-diameter ratio and receives a through bore; grooving, threading, and part-off are omitted because no such features exist and individual sawn blanks are used."
    },
    {
      "assumption_id": "A09",
      "text": "The F02 undercut is retained as a dedicated operation because its depth and form are separately controlled; the small shoulder radius is produced incidentally by the undercut tool."
    },
    {
      "assumption_id": "A10",
      "text": "Heat-treatment masking, quench straightening, and a separate stress-relief cycle are omitted for the default short case-hardened gear because the drawing does not specify selective carburizing or a straightness requirement."
    },
    {
      "assumption_id": "A11",
      "text": "Broach setup cleaning is included in the broaching setup, while broach inspection is covered by the finish-blank, pre-HT, and final inspection gates."
    },
    {
      "assumption_id": "A12",
      "text": "The coating sequence is omitted because the drawing specifies no coating; shot blasting is included only as the required post-HT descaling step."
    },
    {
      "assumption_id": "A13",
      "text": "A custom pitch-diameter diaphragm fixture is assumed to make the corrected single-setup hard turning of the bore, faces, and hub feasible without damaging the hardened teeth."
    },
    {
      "assumption_id": "A14",
      "text": "No dedicated teeth-chamfering or shot-blasting machine key appears in the allowed profile, so these required processes are represented by the nearest valid machine families and marked as subcontracted."
    }
  ]

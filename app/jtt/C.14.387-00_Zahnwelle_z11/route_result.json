    {
      "assumption_id": "A01",
      "text": "Round bar is used because quantity 100 is below the stated forging-volume threshold and the geometry does not require a near-net forging."
    },
    {
      "assumption_id": "A02",
      "text": "An \u00d818 mm bar is selected as a standard size providing machining allowance above the 14.25 mm maximum finished diameter."
    },
    {
      "assumption_id": "A03",
      "text": "Stock cut length and weight are left undefined because the graph reports a contradictory 14.25 mm envelope length while also identifying 61.4 mm as an overall reference length."
    },
    {
      "assumption_id": "A04",
      "text": "The DIN-quality hard-turning correction is adapted to this shaft geometry by finalizing the journals, gear tip OD, and accessible faces in one post-HT setup because no conventional through bore exists."
    },
    {
      "assumption_id": "A05",
      "text": "ID grinding, bore honing, face grinding, OD grinding, gear grinding, and teeth honing are omitted under corrections GEAR-001 and GEAR-002."
    },
    {
      "assumption_id": "A06",
      "text": "Gear face grinding and bore honing from the standard gear sequence are replaced by the single CNC hard-turning operation required by GEAR-002."
    },
    {
      "assumption_id": "A07",
      "text": "The turning-template rough-bore, finish-bore, threading, and part-off steps are omitted because the graph contains no conventional bore or thread and the route uses individually sawn blanks."
    },
    {
      "assumption_id": "A08",
      "text": "Only center drilling from the hole-making sequence applies; pilot drilling, full-size drilling, reaming, tapping, and fastener-seat operations are omitted because no corresponding features exist."
    },
    {
      "assumption_id": "A09",
      "text": "Carburizing is applied over the complete part because the drawing does not specify selectively soft or masked surfaces."
    },
    {
      "assumption_id": "A10",
      "text": "A separate stress-relief cycle is omitted because it is not specified; straightening is performed in the required as-quenched condition before tempering."
    },
    {
      "assumption_id": "A11",
      "text": "The retrieved coating sequence is excluded because no coating is specified; shot blasting is used only as post-heat-treatment descaling required by the corrected gear route."

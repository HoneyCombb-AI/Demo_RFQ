  "assumptions": [
    {
      "assumption_id": "A01",
      "text": "Selected \u00d828 mm round bar with approximately 164 mm blank length, providing 3 mm diametral stock and about 7.4 mm total facing allowance."
    },
    {
      "assumption_id": "A02",
      "text": "Standard bar machining is preferred over forging at 100 pieces because the geometry is a slender shaft, material is specified in the +C condition, and the expected material utilization does not justify forging tooling."
    },
    {
      "assumption_id": "A03",
      "text": "Both center holes are established before OD machining, and a face-driver/between-centers setup is used because the shaft L/D ratio exceeds 4:1 and the runout-controlled features share one axis."
    },
    {
      "assumption_id": "A04",
      "text": "F11, F15, F23, and F28 are left with post-hardening grinding stock; other turned features are soft-finished unless the missing surface-finish assignment indicates otherwise."
    },
    {
      "assumption_id": "A05",
      "text": "The induction-hardening default scope excludes the center holes, wrench flats, and threaded-end region pending customer confirmation."
    },
    {
      "assumption_id": "A06",
      "text": "A qualified low-temperature temper is included after induction quenching and pre-temper straightening to control brittleness while preserving the specified 520\u2013620 HV5 hardness."
    },
    {
      "assumption_id": "A07",
      "text": "F20 is a 1.2 mm incidental transition radius produced by the finish-turning tool path for F19 rather than by a separate form operation."
    },
    {
      "assumption_id": "A08",
      "text": "The turning-template rough-bore and finish-bore steps are omitted because F03 and F14 are standard center holes rather than functional cylindrical bores."
    },
    {
      "assumption_id": "A09",
      "text": "The turning-template part-off step is omitted because individual saw-cut blanks are faced from both ends rather than bar-fed and parted."
    },
    {
      "assumption_id": "A10",
      "text": "The milling-template saw step is already satisfied by Operation 1; datum face milling, profile milling, pocketing, slotting, drilling, reaming, tapping, and counterboring are omitted because the only prismatic features are the two wrench flats and their associated chamfer."
    },
    {
      "assumption_id": "A11",
      "text": "The heat-treatment template's furnace loading, austenitizing, soaking, and tank-quenching steps are consolidated into the controlled induction_harden cycle with integrated spray quenching."
    },
    {
      "assumption_id": "A12",
      "text": "Separate post-temper stress relief is omitted because it is not specified; the qualified induction-hardening and tempering cycle is assumed to provide adequate dimensional stability for final grinding."
    },
    {
      "assumption_id": "A13",
      "text": "Grinding-template face grinding is replaced by reconditioning the two center holes, which are the technological grinding datums for this shaft. ID grinding, flat-surface grinding, profile grinding, bore honing, superfinishing, and production lapping of functional surfaces are omitted because no corresponding requirement is identified."
    },
    {
      "assumption_id": "A14",
      "text": "For black oxide, separate masking, curing, and unmasking steps are omitted because black oxidation is a conversion finish with negligible buildup and no coating-free surfaces are specified."
    },
    {
      "assumption_id": "A15",
      "text": "The surface-treatment template's complete-machining gate is satisfied by Operations 1\u201314, and coating inspection is incorporated into the final inspection."
    }
  ]
}

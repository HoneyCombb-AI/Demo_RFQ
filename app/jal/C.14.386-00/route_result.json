  "clarifications": [
    {
      "clarification_id": "C01",
      "question": "Does the hardness callout \u201c630+100 HV10\u201d define an acceptable range of 630\u2013730 HV10?",
      "blocks": [
        10,
        11,
        16
      ],
      "suggested_default": "Treat the callout as 630\u2013730 HV10 and verify it on the heat-treatment certificate and witness coupon.",
      "priority": "medium"
    },
    {
      "clarification_id": "C02",
      "question": "Is the gear-hobbing cell equipped with dedicated tooling approved for post-heat-treatment tooth chamfering?",
      "blocks": [
        12
      ],
      "suggested_default": "Use the gear_hobbing family with dedicated carbide gear-chamfer tooling; subcontract dedicated teeth chamfering if this tooling is unavailable.",
      "priority": "medium"
    }
  ],
  "assumptions": [
    {
      "assumption_id": "A01",
      "text": "The 20.1 mm envelope width is the axial overall length; \u00d868 \u00d7 28 mm round-bar blanks provide suitable turning and facing allowance."
    },
    {
      "assumption_id": "A02",
      "text": "Round bar is used rather than a forging because the gear is a simple rotational part and the drawing does not require a forged blank or directional grain flow."
    },
    {
      "assumption_id": "A03",
      "text": "Individual saw-cut blanks are used, so the turning-template part-off step is omitted."
    },
    {
      "assumption_id": "A04",
      "text": "Turning-template grooving and threading steps are omitted because no groove or thread features exist in the feature graph."
    },
    {
      "assumption_id": "A05",
      "text": "Pilot drilling, peck drilling, reaming, and tapping are omitted because the short \u00d815 through bore is spot-drilled, drilled, and progressively bored in the lathe."
    },
    {
      "assumption_id": "A06",
      "text": "Post-heat-treatment ID grinding, bore honing, and lapping are omitted under correction GEAR-002; CNC hard boring is used for the final H7 bore."
    },
    {
      "assumption_id": "A07",
      "text": "Gear grinding and teeth honing are omitted under correction GEAR-001 because DIN quality 8 is achieved by soft hobbing and shaving."
    },
    {
      "assumption_id": "A08",
      "text": "Face grinding and OD grinding are omitted under correction GEAR-002; the faces and bore are hard turned, while the tooth-tip OD remains established by soft blank turning and hobbing."
    },
    {
      "assumption_id": "A09",
      "text": "No carburizing mask is applied because the drawing specifies general case hardening and identifies no surfaces that must remain soft."
    },
    {
      "assumption_id": "A10",
      "text": "Quench straightening is omitted because the compact 20 mm-wide gear has no long shaft section; distortion is controlled by furnace racking and hard-turn allowance."
    },
    {
      "assumption_id": "A11",
      "text": "A separate post-temper stress-relief cycle is omitted because it is not specified and would risk altering the required hardness."
    },
    {
      "assumption_id": "A12",
      "text": "The surface-treatment coating route is not used because no coating is specified; shot blasting is included only as heat-treatment descaling."
    }
  ]
}

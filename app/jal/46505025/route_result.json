  "assumptions": [
    {
      "assumption_id": "A01",
      "text": "Standard round bar is used because the part is predominantly rotational and the drawing does not require a forging or directional grain flow; quantity 100 alone does not justify forging."
    },
    {
      "assumption_id": "A02",
      "text": "The local Z directions assigned to F07 and F08 are interpreted as detail-view coordinates for a coaxial right-side bore opening."
    },
    {
      "assumption_id": "A03",
      "text": "F14 is treated as a blind internal spline and therefore gear-shaped; broaching is omitted because a broach requires an open tool exit."
    },
    {
      "assumption_id": "A04",
      "text": "All tight-tolerance faces, Datum A, the F14 bore diameter, and external spline flanks retain suitable stock for post-carburizing hard finishing."
    },
    {
      "assumption_id": "A05",
      "text": "F02 is drilled without reaming because its +0.10/0 mm tolerance does not require an H7-class reamed hole."
    },
    {
      "assumption_id": "A06",
      "text": "The turning-template part-off step is omitted because individual blanks are saw cut and both end faces are subsequently finish machined."
    },
    {
      "assumption_id": "A07",
      "text": "Face milling, profile milling, pocket milling, slot milling, reaming, and VMC tapping are omitted because no corresponding prismatic features exist; the milling route contributes only the radial cross-hole sequence."
    },
    {
      "assumption_id": "A08",
      "text": "Gear shaving is omitted because hard grinding is provided for the tightly controlled external spline, and no separate pre-heat-treatment shaved finish or gear quality class is specified."
    },
    {
      "assumption_id": "A09",
      "text": "Teeth honing is omitted because no final tooth-flank roughness or quality class requiring honing is specified."
    },
    {
      "assumption_id": "A10",
      "text": "ID grinding replaces bore honing on F14 because the interrupted internal spline form is unsuitable for conventional bore honing and the extracted control applies to its bore diameter and concentricity."
    },
    {
      "assumption_id": "A11",
      "text": "Automatic straightening and stress relieving are conditional and omitted from the base route because the part is short and stiff; parts exceeding retained grinding allowance are segregated after heat treatment."
    },
    {
      "assumption_id": "A12",
      "text": "A sealed controlled-atmosphere cycle is assumed, so aggressive shot blasting is omitted; post-quench washing is retained to remove oil and masking residue."
    },
    {
      "assumption_id": "A13",
      "text": "The alternative R0.5 corner execution F06 is selected and produced by a dedicated lathe form pass."
    },
    {
      "assumption_id": "A14",
      "text": "Lapping and superfinishing are omitted because the specified Ra 0.2\u20130.4 class surfaces can be achieved by controlled CBN grinding."
    }
  ]
}

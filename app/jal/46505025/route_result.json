        12,
        14,
        15,
        16,
        17,
        18
      ],
      "suggested_default": "Use controlled-atmosphere gas carburizing followed by quench and temper, consistent with the cementazione callout.",
      "priority": "high"
    },
    {
      "clarification_id": "C02",
      "question": "Which effective case-depth range controls: 0.55\u20130.85 mm or 0.6\u20130.9 mm?",
      "blocks": [

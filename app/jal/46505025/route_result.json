  "assumptions": [
    {
      "assumption_id": "A01",
      "text": "A \u00d854.0 \u00d7 50.1 mm round-bar blank was selected from the 49 mm maximum diameter and 42.1 mm envelope length, providing 5 mm diametrical and 8 mm axial allowance."
    },
    {
      "assumption_id": "A02",
      "text": "The numerical finish symbols on F05, F11, and F13 were interpreted as micrometre Ra requirements."
    },
    {
      "assumption_id": "A03",
      "text": "Pending clarification, F07 and F08 are treated as coaxial right-end internal details rather than global-Z transverse features."
    },
    {
      "assumption_id": "A04",
      "text": "The optional F06 R0.5 shoulder fillet is produced incidentally by the F05 finish-turning tool path and therefore has no separate form-turning sub-operation."
    },
    {
      "assumption_id": "A05",
      "text": "F13 and the F05 flange OD retain post-heat-treatment OD-grinding stock; all other turned, bored, threaded, and spline features are completed to final process size in the soft condition."
    },
    {
      "assumption_id": "A06",
      "text": "Part-off was omitted because the route uses individual saw-cut blanks followed by dedicated two-end facing rather than bar-fed turning."
    },
    {
      "assumption_id": "A07",
      "text": "Gear shaving, tooth grinding, tooth honing, face grinding, ID grinding, bore honing, lapping, and superfinishing were removed under the applicable splined-shaft corrections; spline teeth are generated to final form before heat treatment."
    },
    {
      "assumption_id": "A08",
      "text": "Pilot drilling, peck drilling, reaming, countersinking, and counterboring were omitted where the extracted hole geometry and tolerances do not require them; each twist-drilled hole is still preceded by an existing center or spot feature."
    },
    {
      "assumption_id": "A09",
      "text": "No separate plating or coating route was added because the drawing's coating wording describes the carburizing, quenching, and tempering treatment rather than a deposited coating."
    },
    {
      "assumption_id": "A10",
      "text": "The 100-piece normalization, carburizing, and tempering batches are expected to fit one furnace load each; final rack capacity remains subject to production scheduling."
    },
    {
      "assumption_id": "A11",
      "text": "The F02 description, axial position, and intersection relationships were taken as controlling over its extracted +X axis_direction, so it is routed as a transverse cross-hole."
    }
  ]

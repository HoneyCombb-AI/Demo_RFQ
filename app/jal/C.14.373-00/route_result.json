  "clarifications": [
    {
      "clarification_id": "C01",
      "question": "What tooth-tip rounding value is required for the gear data parameter r_k?",
      "blocks": [
        5,
        6,
        12
      ],
      "suggested_default": "Use the standard DIN 3972/II hob-generated tip condition unless a dedicated tip radius is specified.",
      "priority": "high"
    },
    {
      "clarification_id": "C02",
      "question": "Is subcontracting a dedicated post-heat-treatment gear teeth-chamfering process approved?",
      "blocks": [
        12
      ],
      "suggested_default": "Subcontract post-HT teeth chamfering because no dedicated teeth-chamfering machine is listed in the shop profile.",
      "priority": "high"
    },
    {
      "clarification_id": "C03",
      "question": "Can the in-house shot-peening equipment perform controlled shot blasting for scale removal?",
      "blocks": [
        13
      ],
      "suggested_default": "Subcontract shot blasting rather than substituting shot peening without process approval.",
      "priority": "medium"
    },
    {
      "clarification_id": "C04",
      "question": "Does the CNC lathe support main/subspindle transfer for hard-turning both faces and the bore in one machine load?",
      "blocks": [
        15
      ],
      "suggested_default": "Use a CNC lathe with internal main/subspindle transfer to comply with the required single hard-turning operation.",
      "priority": "medium"
    }
  ],
  "assumptions": [
    {
      "assumption_id": "A01",
      "text": "Round bar is used instead of a forging because the geometry is simple and the quantity of 100 does not justify dedicated forging tooling."
    },
    {
      "assumption_id": "A02",
      "text": "Selected \u00d844 x 22 mm saw-cut stock from the 39.79 x 14 mm envelope, providing diameter, facing, and workholding allowance."
    },
    {
      "assumption_id": "A03",
      "text": "The \u00d839.79 surface is treated as the external tooth-tip OD and receives post-heat-treatment OD grinding because it carries a 0.035 mm runout requirement to datum A."
    },
    {
      "assumption_id": "A04",
      "text": "Mapped the correction's requested cylindrical grinder to the shop's exact machine-family key od_grinding."
    },
    {
      "assumption_id": "A05",
      "text": "The soft-machined bore and OD chamfers are compensated for subsequent face stock removal so the final chamfers remain to drawing size after hard turning."
    },
    {
      "assumption_id": "A06",
      "text": "Part-off is omitted because each component starts as an individual saw-cut blank rather than being parted from bar in the lathe."

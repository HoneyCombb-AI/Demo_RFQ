  "assumptions": [
    {
      "assumption_id": "A01",
      "text": "Detail A (detail_a:F1) is the enlargement of the left shoulder/undercut shown on front_view:F3 (Signal 1 via detail callout). Detail A chosen as canonical because it defines the micro-profile (step, radii, taper)."
    },
    {
      "assumption_id": "A02",
      "text": "Detail B (detail_b:F3) is the enlargement for the right transition/relief zone marked on front_view:F7 (Signal 1 via detail callout). Detail B chosen as canonical for this zone; the 10° callout on front_view:F7 likely applies to an adjacent macro taper while the 15° in Detail B applies to the relief face; both callouts are kept but angle conflicts, if any, resolve to Detail B."
    },
    {
      "assumption_id": "A03",
      "text": "Auxiliary views of the gear (auxiliary_view_1:F1 and auxiliary_view_2:F1) were NOT grouped with front_view:F4. There are no explicit cross-references, and aux_view_1 shows a conflicting length (20.9 vs 23). They remain singletons to avoid contaminating canonical dimensions."
    },
    {
      "assumption_id": "A04",
      "text": "Datum B defined in detail_b is attached to the rightmost Ø6 journal (front_view:F8), consistent with front view datum flag and description; only one B datum is created in the scheme."
    },
    {
      "assumption_id": "A05",
      "text": "Unattached callouts UC1 (overall length, REF), UC2 and UC3 appear to span multiple features/overall stack and are not attributable to a single feature for machining; they are dropped as general chain/reference dimensions."
    }
  ]

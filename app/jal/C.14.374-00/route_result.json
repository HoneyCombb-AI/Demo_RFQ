  "assumptions": [
    {
      "assumption_id": "A01",
      "text": "The 61.4 mm envelope width is interpreted as the shaft's axial finished length; the listed 11.79 mm envelope length is interpreted as a transposed radial value."
    },
    {
      "assumption_id": "A02",
      "text": "F06 and F14 are treated as duplicate representations of the left end journal, and F11 and F20 are treated as duplicate representations of the right end journal."
    },
    {
      "assumption_id": "A03",
      "text": "Commercial \u00d816 round bar cut to 69.4 mm is used, providing approximately 4.2 mm diametral stock and 8 mm total facing allowance."
    },
    {
      "assumption_id": "A04",
      "text": "No forging is used because the part is a small, predominantly rotational shaft, no forged blank or directional grain-flow requirement is specified, and the quantity alone does not justify forming."
    },
    {
      "assumption_id": "A05",
      "text": "Soft finishing leaves suitable heat-treatment allowance on the bores, faces, datum journals, and \u00d89 runout surface for the corrected post-HT CNC hard-turning process."
    },
    {
      "assumption_id": "A06",
      "text": "Turning-template threading and part-off steps are omitted because no threads exist and the route uses individually sawn blanks; hole-template reaming, tapping, counterboring, and deep-hole drilling are omitted because no such features are specified."
    },
    {
      "assumption_id": "A07",
      "text": "Gear grinding, teeth honing, ID grinding, bore honing, face grinding, and OD grinding are removed under GEAR-001 and GEAR-002; CNC hard turning is used for required post-HT dimensional recovery."
    },
    {
      "assumption_id": "A08",
      "text": "Pre-HT tooth and edge deburring is retained as a separate soft-condition operation between shaving and the required pre-HT inspection gate."
    },
    {
      "assumption_id": "A09",
      "text": "Furnace loading, controlled heating, carburizing soak, transfer, and quenching are represented by the carburize and austenitize_quench sub-operations; separate masking and stress-relief steps are omitted because neither is specified."
    },
    {
      "assumption_id": "A10",
      "text": "No coating route is included because the drawing specifies no coating; shot blasting is retained only as the required post-HT descaling step."
    },
    {
      "assumption_id": "A11",
      "text": "Because the shop profile has no dedicated teeth-chamfering machine-family key, the separate post-HT teeth-chamfer operation is assigned to the in-house gear_shaving family using dedicated hardened-gear chamfer tooling."
    },
    {
      "assumption_id": "A12",
      "text": "The canonical F08 gear length of 23 mm is used instead of the conflicting 20.9 mm singleton auxiliary-view value."
    },
    {
      "assumption_id": "A13",
      "text": "Facing and non-feature-producing support, cleaning, heat-treatment, blasting, and inspection steps use empty target_feature_ids because no end-face or process-result feature IDs are present in the graph."
    },
    {
      "assumption_id": "A14",
      "text": "The pre-loaded milling sequence is not used because the graph contains no prismatic, off-axis, slotted, pocketed, or cross-drilled features requiring a milling setup."
    }
  ]

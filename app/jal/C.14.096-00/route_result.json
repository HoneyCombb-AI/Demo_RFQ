  "assumptions": [
    {
      "assumption_id": "A01",
      "text": "The component is routed as a single monolithic rotational part."
    },
    {
      "assumption_id": "A02",
      "text": "Because the material callout is missing, the provisional route assumes annealed or normalized steel with medium machinability."
    },
    {
      "assumption_id": "A03",
      "text": "Round bar is selected for 100 pieces because the part is compact and rotational, no forming requirement is specified, and the quantity is below the stated forging-volume guideline."
    },
    {
      "assumption_id": "A04",
      "text": "Stock diameter, billet length, mass, and machining allowance are left unresolved because the finished outside diameter and material density are absent."
    },
    {
      "assumption_id": "A05",
      "text": "The curved through bore is provisionally produced by drilling followed by rough and finish contour boring; reaming is omitted because the bore is not described as a constant-diameter cylindrical hole."
    },
    {
      "assumption_id": "A06",
      "text": "F06 and F07 are treated as two axial sections of one 43-tooth straight spur gear with common tooth indexing, based on the extraction assumptions."
    },
    {
      "assumption_id": "A07",
      "text": "No heat treatment is included because none is specified; all operations therefore remain in the soft material state."
    },
    {
      "assumption_id": "A08",
      "text": "Gear shaving, case hardening, face grinding, bore honing, gear grinding, and teeth honing are omitted because no heat treatment, gear quality grade, bore fit, or hardened finish requirement is specified."
    },
    {
      "assumption_id": "A09",
      "text": "Milling-template operations are omitted because the extracted component has no prismatic, off-axis, pocket, slot, or cross-hole features."
    },
    {
      "assumption_id": "A10",
      "text": "Threading, tapping, countersinking, and counterboring are omitted because no threaded or fastener-hole features exist in the feature graph."
    },
    {
      "assumption_id": "A11",
      "text": "A separate dimensional chamfering operation is omitted because no chamfer feature or size is extracted; unspecified sharp-edge treatment is covered by bench deburring."
    },
    {
      "assumption_id": "A12",
      "text": "The two gear blank ODs are assumed to share one finished diameter, permitting them to be rough-turned and finish-turned as a common-diameter feature group."
    }
  ]

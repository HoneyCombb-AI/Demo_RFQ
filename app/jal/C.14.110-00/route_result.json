  "clarifications": [
    {
      "clarification_id": "C01",
      "question": "May the required post-heat-treatment tooth chamfering be subcontracted because no dedicated teeth-chamfering machine family is listed in the shop profile?",
      "blocks": [
        12
      ],
      "suggested_default": "Subcontract dedicated hardened-gear teeth chamfering and retain gear_hobbing as the closest permitted gear-cutting family key.",
      "priority": "medium"
    },
    {
      "clarification_id": "C02",
      "question": "Is the entire gear to be carburized, including the bore and both side faces, without selective masking?",
      "blocks": [
        10
      ],
      "suggested_default": "Carburize the complete part without masking, then hard-turn the bore and faces to final dimensions.",
      "priority": "medium"
    }
  ],
  "assumptions": [
    {
      "assumption_id": "A01",
      "text": "Individual blanks are sawed from standard \u00d842 mm round bar rather than parted from a continuous bar because the route uses two controlled turning setups and a short production run of 100 pieces."
    },
    {
      "assumption_id": "A02",
      "text": "Soft turning finishes the tooth-tip blank OD before hobbing but leaves controlled heat-treatment allowance on the \u00d89 bore and both side faces for the mandated post-HT hard-turning operation."
    },
    {
      "assumption_id": "A03",
      "text": "The effective carburized case depth is interpreted as 0.3 mm with a +0.2 mm tolerance, consistent with the feature-graph source assumption."
    },
    {
      "assumption_id": "A04",
      "text": "The post-HT teeth-chamfering process is set to retain the required tooth-edge chamfer after the small face stock allowance is removed during subsequent hard turning."
    },
    {
      "assumption_id": "A05",
      "text": "Turning-template grooving, threading, and part-off steps and hole-making pilot drilling, peck drilling, tapping, reaming, counterboring, and countersinking were omitted because no corresponding features exist and the 14 mm through bore is short relative to its diameter."
    },
    {
      "assumption_id": "A06",
      "text": "Pre-HT finish boring, post-HT ID grinding, bore honing, face grinding, and OD grinding were replaced by CNC hard turning in accordance with correction GEAR-002; bore lapping was omitted because no ultra-precision requirement is specified."
    },
    {
      "assumption_id": "A07",
      "text": "Gear grinding and teeth honing were omitted in accordance with correction GEAR-001 because DIN quality 8d is achieved by hobbing and soft shaving."
    },

  "assumptions": [
    {
      "assumption_id": "A01",
      "text": "Detail views X, Y, and Z depict local undercuts/transition features not explicitly modelled as separate features in the main view; to avoid merging dissimilar geometry, these were kept as standalone features rather than grouped to main-view steps or chamfers despite nearby “Detail X/Y/Z” callouts."
    },
    {
      "assumption_id": "A02",
      "text": "External spline across sections grouped using Signals 4 and detail-view linkage: main_view:F6 chosen canonical due to explicit dimensions and runout GD&T; left_end_view:F2’s Ø11.93 is marked REF and treated as non-controlling."
    },
    {
      "assumption_id": "A03",
      "text": "Opposite flats are interchangeable instances (no per-instance identifiers). One feature group created with count=2 from left_end_view:F1; isometric_views:F3 included as a supporting member."
    },
    {
      "assumption_id": "A04",
      "text": "Isometric \"End Journals\" (isometric_views:F4, count=2) is an aggregate observation spanning both end journals; it is referenced as an aggregate_ref conceptually for both journals but no explicit multi-section group was created for each journal since no second dimensional member exists."
    },
    {
      "assumption_id": "A05",
      "text": "Coaxial relationships among the cylindrical features (journals, steps, spline, central shaft) are established from consistent axis_direction = X and the overall shaft depiction; no conflicting evidence was present."
    },
    {
      "assumption_id": "A06",
      "text": "Coordinate system set with X as primary machining axis per main view notes; datum origin taken as A (left journal) though runout references use AB as the common axis."
    },
    {
      "assumption_id": "A07",
      "text": "Chamfer–adjacent-feature intersecting relationships were added where the drawing clearly shows chamfers at step/spline transitions; no attempt was made to encode exact offsets."
    },
    {
      "assumption_id": "A08",
      "text": "GD&T boxes reading “A B” are interpreted as references to both datums A and B; separate datum_referenced edges were created to A and to B."
    },
    {
      "assumption_id": "A09",
      "text": "Detail X and Z undercuts are assumed to be applied to the larger adjacent diameters (Ø11 steps) at those shoulders; base diameters are not duplicated into the undercut features to avoid cross-feature field sourcing."
    },
    {
      "assumption_id": "A10",
      "text": "Gear data table linked to the splined section as the functional external gearing; pitch diameter 10 mm (m=1, z=10) is consistent with the drawn OD ≈12.68 mm given addendum modification, so no separate gear feature was created."
    },
    {
      "assumption_id": "A11",
      "text": "Set the pair of parallel flats (across-flats 8.93) to extend along the full 66 mm central Ø11.93 shaft section."
    },
    {
      "assumption_id": "A12",
      "text": "Set the 0.2 mm radial depth in Detail Y relative to the central shaft OD Ø11.93 as the base diameter."
    }
  ]

    {
      "clarification_id": "C01",
      "question": "What are the axial start and end limits of the two opposed flats F02?",
      "blocks": [
        4,
        6
      ],
      "suggested_default": "Machine F02 on the exposed central-shaft region identified by the drawing, stopping clear of F01 and its runout reliefs.",
      "priority": "high"
    },
    {
      "clarification_id": "C02",
      "question": "Should the generic post-heat-treatment bore-finishing requirement in correction GEAR-002 be treated as not applicable because this shaft has only center holes F10 and F15?",
      "blocks": [
        17
      ],
      "suggested_default": "Treat F10 and F15 as workholding center holes only and use the corrected CNC hard-turning setup for the journals, central OD, intermediate ODs, and accessible shoulder faces.",
      "priority": "medium"
    },
    {
      "clarification_id": "C03",
      "question": "Which approved machine-family or supplier should perform the dedicated hardened teeth-chamfering operation?",
      "blocks": [
        15
      ],
      "suggested_default": "Subcontract dedicated teeth chamfering and use gear_hobbing as the closest permitted controlled machine-family key.",
      "priority": "high"
    }
  ],
  "assumptions": [
    {
      "assumption_id": "A01",
      "text": "A 16 mm diameter by 92 mm long round-bar blank is assumed, providing practical OD and facing allowance around the 12.68 mm by 85 mm finished envelope."
    },
    {
      "assumption_id": "A02",
      "text": "At 100 pieces, standard round bar is assumed more economical than a dedicated forging because the shaft is small, predominantly cylindrical, and does not require near-net forming."
    },
    {
      "assumption_id": "A03",
      "text": "F02 is routed as a paired indexed profile-milling cut on the CNC turn-mill setup; its exact axial limits require clarification before programming."
    },
    {
      "assumption_id": "A04",
      "text": "Soft turning and milling leave controlled heat-treatment cleanup stock on F13, F17, F21, and associated shoulder faces; final tolerance is obtained by the corrected post-HT CNC hard-turning setup."
    },
    {
      "assumption_id": "A05",
      "text": "Gear grinding, teeth honing, OD grinding, ID grinding, face grinding, and bore honing are omitted under corrections GEAR-001 and GEAR-002; DIN 8 tooth quality is obtained by soft hobbing and shaving, while final rotational surfaces are hard turned."
    },
    {
      "assumption_id": "A06",
      "text": "Turning-template bore, threading, and part-off steps are omitted because there is no functional bore or thread and the route uses individually sawed blanks; center drilling replaces general bore machining."
    },
    {
      "assumption_id": "A07",
      "text": "Only the profile-milling element of the milling template applies to F02. Datum face milling, pockets, slots, drilled-hole patterns, reaming, tapping, countersinking, and counterboring are omitted because no corresponding features exist."
    },
    {
      "assumption_id": "A08",
      "text": "The gear-template blank preparation, hobbing, shaving, pre-HT deburring, heat treatment, cleaning, and final gear inspection are retained. Its face grinding and bore honing are replaced by hard turning, and its tooth grinding and honing are removed by the applicable corrections."
    },
    {
      "assumption_id": "A09",
      "text": "The heat-treatment route includes pre-cleaning, furnace loading, carburizing, quenching, as-quenched straightening, tempering, descaling, and hardness/case verification. Selective carburizing mask and additional stress relief are omitted because neither is specified."
    },
    {
      "assumption_id": "A10",
      "text": "The coating surface-treatment sequence is omitted because no coating is specified; post-HT shot blasting is retained solely as heat-treatment descaling required by correction GEAR-003."
    },
    {
      "assumption_id": "A11",
      "text": "Controlled racking, quenching, and straightening are assumed capable of preserving the pre-HT milled flats within their final width and parallelism requirements because the corrections prohibit a separate post-HT flat-grinding operation."
    },
    {
      "assumption_id": "A12",
      "text": "Post-heat-treatment HRC values are left null because the drawing specifies 630+100 HV10 rather than an HRC range; all operations after quenching are nevertheless classified as hardened."
    },
    {
      "assumption_id": "A13",
      "text": "The pre-hob blank inspection checks the center holes as workholding features rather than checking a functional bore, because no through bore is present in the feature graph."
    },
    {
      "assumption_id": "A14",
      "text": "The grinding template is intentionally not used for material removal: its dimensional inspection function is retained in final inspection, while every grinding and honing step is removed by the organizational corrections."
    }
  ]
}

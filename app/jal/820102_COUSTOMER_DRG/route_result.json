  "clarifications": [
    {
      "clarification_id": "C01",
      "question": "Which gear surfaces are required to receive the specified effective case depth and hardness?",
      "blocks": [
        9
      ],
      "suggested_default": "Treat all unmasked surfaces, with acceptance testing focused on the tooth flanks and witness coupon.",
      "priority": "medium"
    },
    {
      "clarification_id": "C02",
      "question": "Must the side face opposite feature F03 also be hard-turned to establish the final 9 mm gear width?",
      "blocks": [
        13
      ],
      "suggested_default": "Hard-turn both side faces during the single post-heat-treatment hard-turning stage.",
      "priority": "medium"
    },
    {
      "clarification_id": "C03",
      "question": "Which valid shop machine-family key should represent the dedicated post-heat-treatment teeth-chamfering machine?",
      "blocks": [
        10
      ],
      "suggested_default": "Use gear_hobbing as the internal gear-cutting equipment-family proxy.",
      "priority": "medium"
    }
  ],
  "assumptions": [
    {
      "assumption_id": "A01",
      "text": "Round bar is selected instead of a forging because the quantity is 100, the part is a simple thin rotational blank, and no metallurgical forging requirement is specified."
    },
    {
      "assumption_id": "A02",
      "text": "A standard 70 mm round bar cut to 14 mm is used to provide OD and two-face machining allowance; stock mass remains undetermined because an approved material density was not supplied."
    },
    {
      "assumption_id": "A03",
      "text": "Soft bore and face machining leaves controlled heat-treatment allowance; organizational correction GEAR-002 replaces the standard post-HT ID grinding, bore honing, face grinding, and OD grinding sequence with CNC hard turning."
    },
    {
      "assumption_id": "A04",
      "text": "The blank is rough-turned on the OD before boring for rigidity, but the finish blank OD is cut in a subsequent bore-located setup to satisfy the drawing dependency requiring OD runout to datum A."
    },
    {
      "assumption_id": "A05",
      "text": "Gear grinding and teeth honing are omitted under GEAR-001 because DIN quality 8 is achieved by soft hobbing followed by shaving."
    },
    {
      "assumption_id": "A06",
      "text": "Turning-template grooving and threading are omitted because no grooves or threads exist; part-off is omitted because individual saw-cut blanks are used. Final inspection is retained at the end of the merged route."
    },
    {
      "assumption_id": "A07",
      "text": "The standard plating/coating surface-treatment sequence is not applicable because no coating is specified; shot blasting is retained solely as post-heat-treatment descaling required by GEAR-003 and the drawing deburring note."
    },
    {
      "assumption_id": "A08",
      "text": "Selective masking, straightening, stress relief, lapping, and post-lap verification are omitted because no selective soft zones, shaft-like distortion condition, stress-relief requirement, or ultra-precision finish is specified."
    },
    {
      "assumption_id": "A09",
      "text": "The inventory has no dedicated teeth-chamfering machine-family key, so gear_hobbing is used as the closest valid in-house gear-equipment family pending confirmation; this is not intended to substitute hobbing for the teeth-chamfer process."
    },
    {
      "assumption_id": "A10",
      "text": "The unmodeled opposite side face is machined wherever required to establish part width and parallelism, but it is assigned an empty target_feature_ids list because only the front face F03 exists in the supplied feature graph."
    },
    {
      "assumption_id": "A11",
      "text": "No deliberate tooth-tip rounding is routed because the supplied feature-graph assumption resolves the unknown r_k value as zero."
    }
  ]
}

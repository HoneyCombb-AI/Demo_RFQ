  "assumptions": [
    {
      "assumption_id": "A01",
      "text": "Because the drawing defines no datum scheme, the first finished face is treated as manufacturing datum A and the common external-thread/central-bore axis as manufacturing datum B."
    },
    {
      "assumption_id": "A02",
      "text": "The \u00d86 central bore has only the general \u00b10.2 mm tolerance and 125 surface-finish requirement, so spot drilling and full-size drilling are used; rough boring, finish boring, reaming, and honing are omitted."
    },
    {
      "assumption_id": "A03",
      "text": "No thread-relief groove or shoulder is present in the feature graph, so the turning-template grooving step is omitted rather than inventing an uncalled feature."
    },
    {
      "assumption_id": "A04",
      "text": "The milling route is used only for the off-center hole pattern. Face milling, profile milling, pocketing, slotting, reaming, tapping, and counterbore/countersink steps are omitted because the corresponding features are absent; datum faces and the circular contour are produced on the lathe."
    },
    {
      "assumption_id": "A05",
      "text": "Pilot drilling, peck drilling, reaming, precision boring, and tapping are omitted from the hole-making route because all holes are short through holes, no hole exceeds 3:1 depth-to-diameter, and no precision fit or internal thread is specified."
    },
    {
      "assumption_id": "A06",
      "text": "The separate turning and milling final-inspection steps are consolidated into the pre-anodize dimensional inspection and the post-anodize final inspection."
    },
    {
      "assumption_id": "A07",
      "text": "Anodize sealing is represented by cure_bake because the controlled operation vocabulary does not provide a dedicated anodize-seal operation."
    }
  ]

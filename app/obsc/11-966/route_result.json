  "clarifications": [
    {
      "clarification_id": "C01",
      "question": "Is F15 actually a \u00d84.4 through-hole, or is it an erroneous extraction of a boss diameter?",
      "blocks": [
        2,
        3,
        9
      ],
      "suggested_default": "Treat F15 as an erroneous, non-machined extraction and manufacture the coaxial 3-56 UNF-3B through thread defined by F01.",
      "priority": "high"
    },
    {
      "clarification_id": "C02",
      "question": "Does the finished component have four radial spokes rather than the three stated in F09?",
      "blocks": [
        4
      ],
      "suggested_default": "Machine four equally spaced spokes, consistent with F08, F10, R10, and R11.",
      "priority": "medium"
    },
    {
      "clarification_id": "C03",
      "question": "Do F03 through F06 define a continuous 360-degree profile around the left entry lip?",
      "blocks": [
        3
      ],
      "suggested_default": "Treat F03 through F06 as continuous turned features around the left entry lip.",
      "priority": "medium"
    },

  "assumptions": [
    {
      "assumption_id": "A01",
      "text": "Standard extruded round bar is used because the envelope is cylindrical, ASTM B221 covers aluminium bar and extrusion products, and the quantity of 100 does not justify dedicated forming tooling."
    },
    {
      "assumption_id": "A02",
      "text": "F15 is omitted from machining because a \u00d84.4 through-hole cannot coexist coaxially with the specified 3-56 UNF-3B through thread; the explicit thread and datum-A definition govern pending clarification."
    },
    {
      "assumption_id": "A03",
      "text": "The spoke and sector pattern is machined as four equally spaced instances despite the isolated three-spoke wording in F09."
    },
    {
      "assumption_id": "A04",
      "text": "F03 through F06 are treated as continuous turned details on the left entry lip in accordance with the feature-graph assumption that they apply 360 degrees."
    },
    {
      "assumption_id": "A05",
      "text": "Pocket milling F08 physically generates the central boss boundary, four spoke boundaries, and hub-to-spoke fillets represented by F02, F10, and F11."
    },
    {
      "assumption_id": "A06",
      "text": "Individual sawed blanks are used, so the turning template's part-off step is dropped; both ends are subsequently faced to finished condition."
    },
    {
      "assumption_id": "A07",
      "text": "Grooving, pilot drilling, peck drilling, reaming, slot milling, keyway milling, and cross-hole drilling are omitted because the feature graph contains no corresponding groove, large-step drill, deep hole, precision reamed hole, slot, keyway, or cross-hole feature."
    },
    {
      "assumption_id": "A08",
      "text": "VMC datum face milling and external profile milling are omitted because datum B and the cylindrical outside profile are finished on the lathe before VMC work; the central hole is drilled and tapped on-center first because it establishes datum A for the milling arbor."
    },
    {
      "assumption_id": "A09",
      "text": "The pin-specific straddle-flat, keyway, and cross-drilling corrections add no operations because this wheel-like part has no opposing arm flats, keyway, or cross-hole; their prohibitions against unnecessary contouring and cosmetic VMC setups are retained."
    },
    {
      "assumption_id": "A10",
      "text": "The in-house plating line is treated as capable of qualified sulfuric Type II anodizing under its stated coating capability; coating growth is to be allowed for when Pass 2 assigns machining geometry."
    }
  ]
}

  "clarifications": [
    {
      "clarification_id": "C01",
      "question": "Is F15 truly a separate \u00d84.4 through-hole, or is that dimension an extraction error associated with an external boss?",
      "blocks": [
        2,
        3,
        4,
        8,
        11
      ],
      "suggested_default": "Treat F15 as an extraction error and manufacture only the explicitly specified 3-56 UNF-3B through-thread on the central axis.",
      "priority": "high"
    },
    {
      "clarification_id": "C02",
      "question": "What finished diameter is required for each countersink at the two ends of F01?",
      "blocks": [
        2,
        3
      ],
      "suggested_default": "Use a thread lead-in chamfer extending approximately 0.25 mm radially beyond the 3-56 major diameter.",
      "priority": "medium"
    },
    {
      "clarification_id": "C03",
      "question": "What included angle is required for the two F01 countersinks?",
      "blocks": [
        2,
        3
      ],
      "suggested_default": "Use a 90-degree included angle.",
      "priority": "medium"
    },
    {
      "clarification_id": "C04",
      "question": "Do F03 through F06 form a continuous 360-degree turned profile on the left entry lip?",
      "blocks": [
        3
      ],
      "suggested_default": "Treat F03 through F06 as a continuous 360-degree profile at the left-side entry lip.",
      "priority": "medium"
    },
    {
      "clarification_id": "C05",
      "question": "Are the four through sector cutouts F08 geometrically separate from the 4 mm-deep right-side lobe pockets F17?",
      "blocks": [
        4
      ],
      "suggested_default": "Treat F08 and F17 as separate pocket sets and machine both from the right side.",
      "priority": "high"
    },
    {
      "clarification_id": "C06",
      "question": "What finished sulfuric Type II anodize thickness range is required?",
      "blocks": [
        2,
        3,
        4,
        9
      ],
      "suggested_default": "Use the supplier's controlled 10\u201315 micrometre total oxide thickness and compensate machined dimensions for approximately half that thickness as outward growth.",
      "priority": "high"
    },
    {
      "clarification_id": "C07",
      "question": "Should the 3-56 UNF-3B thread F01 be masked during anodizing?",
      "blocks": [
        8,
        9,
        11
      ],
      "suggested_default": "Mask the complete thread and both gauging lead-ins to preserve the Class 3B fit.",
      "priority": "medium"
    }
  ],
  "assumptions": [
    {
      "assumption_id": "A01",
      "text": "Round bar is used because the part has a dominant cylindrical envelope; the quantity of 100 and geometry do not justify forging or casting."
    },
    {
      "assumption_id": "A02",
      "text": "F15 is omitted from production pending C01 because a \u00d84.4 through-hole cannot coexist coaxially with the specified 3-56 UNF-3B thread."
    },
    {
      "assumption_id": "A03",
      "text": "F08 and F17 are routed as separate right-side pocket sets pending clarification."
    },
    {
      "assumption_id": "A04",
      "text": "F03 through F06 are treated as individual controlled elements of one 360-degree left entry-lip profile."
    },
    {
      "assumption_id": "A05",
      "text": "The central thread is masked during anodizing so the required Class 3B GO/NO-GO condition is preserved."
    },
    {
      "assumption_id": "A06",
      "text": "Turning-template part-off is omitted because individual blanks are sawed and the second lathe setup faces the part to final length."
    },
    {
      "assumption_id": "A07",
      "text": "A spot drill for the central threaded hole fulfills the center-drilling requirement; tailstock support is unnecessary for the low length-to-diameter ratio."
    },
    {
      "assumption_id": "A08",
      "text": "Grooving and thread-relief operations are omitted because F01 is a through-tapped hole without a terminating thread shoulder."
    },
    {
      "assumption_id": "A09",
      "text": "Milling-template face milling, slot milling and reaming are omitted because datum B is turned, no slot is identified, and no reamed hole is specified."
    },
    {
      "assumption_id": "A10",
      "text": "Hole-route pilot drilling and reaming are omitted because the small tap-drill hole can be peck drilled directly and the finished feature is threaded rather than reamed."
    },
    {
      "assumption_id": "A11",
      "text": "The anodize sealing stage is included in the anodize sub-operation, so no separate cure-bake operation is required."
    },
    {
      "assumption_id": "A12",
      "text": "No heat treatment or grinding is included because the material is supplied in the specified T7351 condition and the drawing calls for no subsequent hardening."
    }
  ]
}

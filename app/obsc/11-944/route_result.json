  "assumptions": [
    {
      "assumption_id": "A01",
      "text": "A standard 19.05 mm extruded round bar is selected, with 6.5 mm equivalent consumption per part for the finished length, facing stock, and parting kerf."
    },
    {
      "assumption_id": "A02",
      "text": "Because the drawing defines no datum scheme, the first finished face is treated as manufacturing datum A and the common thread/bore axis as manufacturing datum B."
    },
    {
      "assumption_id": "A03",
      "text": "The turning template's rough- and finish-boring steps are replaced by full-size on-center drilling because the \u00d86 bore has only the general \u00b10.2 mm tolerance and no precision-fit callout."
    },
    {
      "assumption_id": "A04",
      "text": "Turning grooving is omitted because no groove or thread-relief feature is defined; the external thread terminates with the specified entry and exit chamfers."
    },
    {
      "assumption_id": "A05",
      "text": "Pilot drilling, peck drilling, reaming, tapping, counterboring, pocketing, slotting, and profile milling are omitted because the corresponding features, depth ratios, or precision tolerances are absent."
    },
    {
      "assumption_id": "A06",
      "text": "ALM-TURN-002's mandatory two-lathe-setup rule is not invoked because this part is a thin threaded disc rather than a double-ended bar pin; the opposed face is finished in the VMC setup before drilling."
    },
    {
      "assumption_id": "A07",
      "text": "The saw operation prepares feeder-length bar sections rather than individual 6.5 mm blanks, since individual blanks would not provide practical lathe gripping length."
    },
    {
      "assumption_id": "A08",
      "text": "The anodize sealing stage is represented by cure_bake, the closest controlled-vocabulary operation for the required post-anodize seal."
    }
  ]

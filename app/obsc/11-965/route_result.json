  "clarifications": [
    {
      "clarification_id": "C01",
      "question": "Is the external thread actually 1.25-20 UN-2A, despite its 31.75 mm nominal major diameter conflicting with the stated \u00d828 mm maximum envelope?",
      "blocks": [
        1,
        2,
        7
      ],
      "suggested_default": "For provisional planning, interpret the intended thread as 1-1/8-20 UNEF-2A and retain \u00d832 mm round stock; obtain drawing-authority approval before production.",
      "priority": "high"
    },
    {
      "clarification_id": "C02",
      "question": "Must the external thread receive the chromate conversion coating, or must it be masked?",
      "blocks": [
        4,
        5,
        6
      ],
      "suggested_default": "Mask the external thread during conversion coating.",
      "priority": "medium"
    },
    {
      "clarification_id": "C03",
      "question": "What finished size is required for the entry chamfers on the four \u00d83 mm holes?",
      "blocks": [
        3
      ],
      "suggested_default": "Use a 0.5 mm maximum edge chamfer in accordance with the general deburr note.",
      "priority": "medium"
    },
    {
      "clarification_id": "C04",
      "question": "What included angle is required for the entry chamfers on the four \u00d83 mm holes?",
      "blocks": [
        3
      ],
      "suggested_default": "Use a 90-degree included-angle countersink to produce a 45-degree edge chamfer.",
      "priority": "medium"
    }
  ],
  "assumptions": [
    {
      "assumption_id": "A01",
      "text": "The isometric-view part body is treated as an overall depiction only; machinable features are taken from the main cross-section."
    },
    {
      "assumption_id": "A02",
      "text": "The primary spindle axis is treated as X based on the section view, despite the isometric orientation note."
    },
    {
      "assumption_id": "A03",
      "text": "A \u00d832 mm ASTM B221 extruded round bar is used provisionally for the 100-piece machining route, pending resolution of the thread-diameter conflict."
    },
    {
      "assumption_id": "A04",
      "text": "The controlled parting cycle can produce the opposing face within the general \u00b10.1 mm and 125 surface-finish requirements, so a second lathe facing setup is not required."
    },
    {
      "assumption_id": "A05",
      "text": "A process-only runout groove is cut at the eventual cutoff location before threading and is removed by the final part-off operation."
    },
    {
      "assumption_id": "A06",
      "text": "Prismatic face milling, profile milling, pocket milling, and slot milling are omitted because the lathe produces the cylindrical body and no prismatic milled features are present."
    },
    {
      "assumption_id": "A07",
      "text": "The \u00d83 mm holes are treated as short, standard-tolerance through-holes, so pilot drilling, peck drilling, reaming, boring, and tapping are not applicable."
    },
    {
      "assumption_id": "A08",
      "text": "The specified chromate conversion coating does not require a separate thermal cure or hydrogen-embrittlement relief bake."
    },
    {
      "assumption_id": "A09",
      "text": "The external thread is masked by default during coating until the drawing authority confirms whether all-over conversion treatment is required."
    },
    {
      "assumption_id": "A10",
      "text": "The controlled-vocabulary operation type plate is used to represent the in-house chromate conversion coating process."
    }
  ]
